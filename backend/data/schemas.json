{
  "components": [
    {
      "id": "button",
      "name": "Button",
      "category": "基础组件",
      "description": "按钮用于触发一个操作，如提交表单、打开弹窗等。",
      "keywords": ["按钮", "button", "btn", "点击", "触发", "提交"],
      "props": [
        {
          "name": "type",
          "label": "按钮类型",
          "type": "select",
          "default": "primary",
          "options": [
            { "label": "主按钮", "value": "primary" },
            { "label": "次按钮", "value": "default" },
            { "label": "虚线按钮", "value": "dashed" },
            { "label": "危险按钮", "value": "danger" }
          ]
        },
        {
          "name": "size",
          "label": "尺寸",
          "type": "select",
          "default": "middle",
          "options": [
            { "label": "大", "value": "large" },
            { "label": "中", "value": "middle" },
            { "label": "小", "value": "small" }
          ]
        },
        { "name": "disabled", "label": "是否禁用", "type": "boolean", "default": false },
        { "name": "loading", "label": "是否加载中", "type": "boolean", "default": false }
      ],
      "events": [
        { "name": "click", "label": "点击事件", "description": "点击按钮时触发" }
      ],
      "slots": [
        { "name": "default", "label": "默认插槽", "description": "按钮内容" }
      ]
    },
    {
      "id": "input",
      "name": "Input",
      "category": "表单组件",
      "description": "输入框用于接收用户输入的文本内容。",
      "keywords": ["输入框", "input", "文本框", "输入", "占位"],
      "props": [
        { "name": "placeholder", "label": "占位文本", "type": "string", "default": "请输入" },
        { "name": "maxLength", "label": "最大长度", "type": "number", "default": 100 },
        { "name": "disabled", "label": "是否禁用", "type": "boolean", "default": false },
        { "name": "clearable", "label": "可清空", "type": "boolean", "default": true }
      ],
      "events": [
        { "name": "input", "label": "输入事件", "description": "输入内容变化时触发" },
        { "name": "change", "label": "变更事件", "description": "失焦且值变化时触发" }
      ],
      "slots": []
    },
    {
      "id": "table",
      "name": "Table",
      "category": "数据展示",
      "description": "表格用于展示结构化的列表数据。",
      "keywords": ["表格", "table", "列表", "数据展示", "列"],
      "props": [
        { "name": "columns", "label": "列配置", "type": "array", "default": [] },
        { "name": "data", "label": "数据源", "type": "array", "default": [] },
        { "name": "bordered", "label": "是否带边框", "type": "boolean", "default": true },
        { "name": "loading", "label": "是否加载中", "type": "boolean", "default": false }
      ],
      "events": [
        { "name": "row-click", "label": "行点击", "description": "点击某一行时触发" }
      ],
      "slots": []
    }
  ]
}
